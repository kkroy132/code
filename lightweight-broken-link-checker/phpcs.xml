<?xml version="1.0"?>
<ruleset name="Lightweight Broken Link Checker">
	<description>WordPress Coding Standards for the plugin source.</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!--
			The plugin autoloads with PSR-4 (LWBLC\ => src/), which requires the
			file name to match the class name exactly. That is incompatible with
			the class-*.php file naming rule, so it is switched off for src/ only.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lightweight-broken-link-checker"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
